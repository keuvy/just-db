# Registry host, optionally with port/namespace; no https:// or trailing slash.
# Example: registry.example.com/team
DOCKER_REGISTRY=

# Web UI login. Set both before public deployment; separate from database credentials.
JUSTDB_AUTH_USER=
JUSTDB_AUTH_PASSWORD=

# Comma-separated client IPs or CIDRs. Empty disables IP restriction.
# Example: 203.0.113.10,2001:db8::123
JUSTDB_ALLOWED_IPS=
# Actual reverse proxy peer IPs/CIDRs allowed to supply X-Forwarded-For.
# Set this to your EasyPanel proxy address/network, not your public client IP.
JUSTDB_TRUSTED_PROXIES=
